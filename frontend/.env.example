# Empty uses same-origin /api; Vite proxies this in development.
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:3001
# Set the public canonical origin when deploying.
VITE_SITE_URL=
# Full admin login URL. Set the deployed HTTPS URL before building for production.
# Empty in development opens the existing admin app on this hostname, port 5174.
# Empty in production requires a reverse proxy serving the admin app at /admin/login.
VITE_ADMIN_URL=
