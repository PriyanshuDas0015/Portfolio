# Empty uses same-origin /api; Vite proxies this in development.
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:3001
# Set the public canonical origin when deploying.
VITE_SITE_URL=
# Optional override for the admin login URL. Empty uses the integrated /admin/login route.
# In development the existing standalone admin dev server is opened on port 5174.
VITE_ADMIN_URL=
